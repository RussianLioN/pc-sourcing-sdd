{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "offer_id": {
          "minLength": 1,
          "title": "Offer Id",
          "type": "string"
        },
        "url": {
          "pattern": "^https?://[^\\s]+$",
          "title": "Url",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "origin": {
          "enum": [
            "store_card",
            "seller_statement",
            "platform_transaction",
            "search_snippet"
          ],
          "title": "Origin",
          "type": "string"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "offer_id",
        "url",
        "observed_at",
        "field",
        "value",
        "origin",
        "synthetic"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "confirmed_applicable",
            "confirmed_unavailable",
            "unknown",
            "conflict"
          ],
          "title": "Status",
          "type": "string"
        },
        "covers_item": {
          "default": false,
          "title": "Covers Item",
          "type": "boolean"
        },
        "covers_amount": {
          "default": false,
          "title": "Covers Amount",
          "type": "boolean"
        },
        "covers_region": {
          "default": false,
          "title": "Covers Region",
          "type": "boolean"
        },
        "covers_order": {
          "default": false,
          "title": "Covers Order",
          "type": "boolean"
        },
        "external_advance_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Advance Required"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "reason": {
          "default": "not confirmed",
          "title": "Reason",
          "type": "string"
        }
      },
      "title": "Route",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "product": {
      "enum": [
        "gpu",
        "ram",
        "mouse"
      ],
      "title": "Product",
      "type": "string"
    },
    "sku": {
      "minLength": 1,
      "title": "Sku",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "source": {
      "enum": [
        "store",
        "avito",
        "snippet"
      ],
      "title": "Source",
      "type": "string"
    },
    "url": {
      "pattern": "^https?://[^\\s]+$",
      "title": "Url",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    },
    "price_rub": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Price Rub"
    },
    "currency": {
      "default": "RUB",
      "title": "Currency",
      "type": "string"
    },
    "stock": {
      "enum": [
        "in_stock",
        "preorder",
        "unknown",
        "unavailable"
      ],
      "title": "Stock",
      "type": "string"
    },
    "region": {
      "title": "Region",
      "type": "string"
    },
    "condition": {
      "enum": [
        "new",
        "used",
        "unknown"
      ],
      "title": "Condition",
      "type": "string"
    },
    "seller_checked": {
      "title": "Seller Checked",
      "type": "boolean"
    },
    "factory_liquid": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Factory Liquid"
    },
    "global_advance_required": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Global Advance Required"
    },
    "global_payment_conflict": {
      "default": false,
      "title": "Global Payment Conflict",
      "type": "boolean"
    },
    "optional_risky_alternative": {
      "default": false,
      "title": "Optional Risky Alternative",
      "type": "boolean"
    },
    "protected": {
      "$ref": "#/$defs/Route",
      "default": {
        "schema_version": "1.0.0",
        "status": "unknown",
        "covers_item": false,
        "covers_amount": false,
        "covers_region": false,
        "covers_order": false,
        "external_advance_required": null,
        "evidence_ids": [],
        "reason": "not confirmed"
      }
    },
    "postpay": {
      "$ref": "#/$defs/Route",
      "default": {
        "schema_version": "1.0.0",
        "status": "unknown",
        "covers_item": false,
        "covers_amount": false,
        "covers_region": false,
        "covers_order": false,
        "external_advance_required": null,
        "evidence_ids": [],
        "reason": "not confirmed"
      }
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "id",
    "product",
    "sku",
    "title",
    "source",
    "url",
    "observed_at",
    "synthetic",
    "price_rub",
    "stock",
    "region",
    "condition",
    "seller_checked",
    "evidence"
  ],
  "title": "Offer",
  "type": "object"
}
